# Configuración local privada: copia este archivo a .env y completa tus valores.
# No compartas ni subas el archivo .env. Reinicia el servidor tras guardarlo.
PENDIVA_AI_PROVIDER=nebius
NEBIUS_API_KEY=
MODEL_API_KEY=
NVIDIA_API_KEY=
# Opcional: voz de ElevenLabs (la clave nunca se envía al navegador).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
WHATSAPP_PHONE_NUMBER_ID=1449942894872373
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_APP_ID=889989257436890
PENDIVA_PORT=8000
PENDIVA_WEBHOOK_PORT=8772
# Protege el panel local; deja vacío sólo para desarrollo estrictamente local.
PENDIVA_AUTH_PASSWORD=

# Solo para enviar un mensaje de prueba explícitamente con whatsapp_test_smoke.
WHATSAPP_TEST_GRAPH_VERSION=v25.0
WHATSAPP_TEST_PHONE_NUMBER_ID=1449942894872373
WHATSAPP_TEST_ACCESS_TOKEN=
WHATSAPP_TEST_RECIPIENT=
